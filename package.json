{
  "name": "polymarket-weather-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Probabilistic trading bot for Polymarket daily-high temperature markets",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "dev": "tsx src/index.ts",
    "scan": "tsx src/index.ts scan",
    "forecast": "tsx src/index.ts forecast",
    "run-once": "tsx src/index.ts run",
    "watch": "tsx src/index.ts watch",
    "auth": "tsx src/index.ts auth",
    "portfolio": "tsx src/index.ts portfolio",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@polymarket/client": "0.17.0",
    "dotenv": "16.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "packageManager": "npm@11.12.1"
}
