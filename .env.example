# Phase 1: public data and local paper simulation only.
# No wallet or API credentials are needed. Do not add private keys or secrets.
# Authentication and all live order submissions are disabled.
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com

# ─── Trading mode & risk limits ───────────────────────────────────────────────
# paper = simulate fills locally; live is blocked in Phase 1.
TRADING_MODE=paper

# Minimum model-vs-market edge (probability points, 0-1) to consider a trade.
MIN_EDGE=0.08

# Edges ABOVE this are treated as model error (not opportunity) and skipped.
# A 40pp+ disagreement with a liquid market almost always means you're wrong.
EDGE_SANITY_CAP=0.35

# Skip events resolving sooner than this many minutes from now.
MIN_MINUTES_TO_RESOLVE=60

# Ensemble spread inflation (>1). Daily-max ensembles are under-dispersed; this
# widens the predictive distribution so the model stops claiming false certainty.
SPREAD_INFLATION=1.4

# Shrinkage: how much to trust the MODEL vs the (de-vigged) MARKET when forming
# the probability we actually trade on. 1.0 = model only, 0.0 = market only.
# Keep moderate (0.4-0.6) until you've calibrated per-city biasC against history.
MODEL_WEIGHT=0.5

# Correlation discount for stacking same-direction bets across buckets in one
# event (e.g. NO on 29°C, 30°C, 31°C are nearly the same view). Each extra bet's
# stake is multiplied by this^k. 1.0 disables; 0.5 halves each successive bet.
CORRELATION_DECAY=0.5

# Only trade markets whose Yes price sits in this band (avoid near-resolved noise).
MIN_PRICE=0.03
MAX_PRICE=0.97

# Fraction of full-Kelly to bet (0.25 = quarter-Kelly). Lower = safer.
KELLY_FRACTION=0.25

# Simulated bankroll (USDC) Kelly sizes against.
BANKROLL=1000

# Hard caps (USDC).
MAX_STAKE_PER_MARKET=50
MAX_STAKE_PER_EVENT=150
MAX_TOTAL_EXPOSURE=1000
MAX_DAILY_LOSS=200

# Minimum order book liquidity (USDC on the relevant side) before we'll trade.
MIN_BOOK_LIQUIDITY=20

# Cities to trade (comma-separated keys from src/weather/cities.ts), or "all".
CITIES=seoul,hong_kong,wellington,nyc

# How many days ahead to consider markets (0 = today only).
MAX_DAYS_AHEAD=2

# Logging: debug | info | warn | error
LOG_LEVEL=info
